{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orin.local/schemas/final_result.v1.schema.json",
  "title": "ORIN Final Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "request_id",
    "client_id",
    "job_id",
    "attempt",
    "requested_mode",
    "effective_mode",
    "status",
    "decision",
    "code_version",
    "config_version",
    "idempotency_key",
    "shopify_article_id",
    "shopify_create_count",
    "shopify_published",
    "queue_changed",
    "reconciliation_status",
    "started_at",
    "finished_at",
    "artifact_uri",
    "error_code",
    "pipeline_exit_code"
  ],
  "properties": {
    "schema": {"const": "orin.final-result/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "format": "uuid"},
    "client_id": {"const": "hoverboard_store"},
    "job_id": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "minimum": 1},
    "requested_mode": {"enum": ["dry-run", "hidden-draft"]},
    "effective_mode": {"type": "string"},
    "status": {"enum": ["completed", "blocked", "failed"]},
    "decision": {"type": "string"},
    "code_version": {"type": "string"},
    "config_version": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string"},
    "shopify_article_id": {"type": ["string", "null"]},
    "shopify_create_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "shopify_published": {"const": false},
    "queue_changed": {"type": "boolean"},
    "reconciliation_status": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "artifact_uri": {"type": "string"},
    "error_code": {"type": ["string", "null"]},
    "pipeline_exit_code": {"type": ["integer", "null"]}
  }
}
