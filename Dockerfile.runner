FROM python:3.12.13-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

ARG VERSION=dev
ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="ORIN Runner" \
      org.opencontainers.image.description="Deterministic, evidence-producing ORIN workflow runner" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/harirajbhattarai/orin-multiagent-commerce-system"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    ORIN_CODE_VERSION=${VCS_REF}

RUN groupadd --gid 10001 orin \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin orin

WORKDIR /app

COPY --chown=10001:10001 src/ ./src/
COPY --chown=10001:10001 tools/ ./tools/
COPY --chown=10001:10001 schemas/ ./schemas/
COPY --chown=10001:10001 pyproject.toml uv.lock ./

USER 10001:10001

ENTRYPOINT ["python", "-m", "orin_runner"]
CMD ["--help"]
