# HCS Gadgets Shopify Admin API config
# Use your .myshopify.com domain, not public domain
SHOPIFY_STORE_DOMAIN=your-hcs-store.myshopify.com

# Keep this secret. Do not paste into ChatGPT.
SHOPIFY_ADMIN_ACCESS_TOKEN=replace_with_shopify_admin_token

SHOPIFY_API_VERSION=2026-01

# After running hcs_fetch_blogs.py, fill either BLOG_ID or BLOG_TITLE
SHOPIFY_BLOG_ID=
SHOPIFY_BLOG_TITLE=News
