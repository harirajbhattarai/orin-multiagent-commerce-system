# Exact reviewed Git commit. Never use a moving branch or latest tag.
ORIN_DEPLOY_SHA=REPLACE_WITH_REVIEWED_40_CHAR_COMMIT

# Separately reviewed Phase 5 watchdog commit. This may advance without
# replacing the proven worker or scheduler-trigger images.
ORIN_WATCHDOG_DEPLOY_SHA=REPLACE_WITH_REVIEWED_40_CHAR_COMMIT

ORIN_PROJECT_ROOT=/docker/openclaw-utgd/data/orin-multiagent-commerce-system
ORIN_RUNTIME_ROOT=/docker/openclaw-utgd/data/.openclaw/workspace
ORIN_EVIDENCE_ROOT=/docker/orin/evidence
ORIN_SECRETS_DIR=/docker/orin/secrets
ORIN_TRIGGER_SOCKET_DIR=/docker/openclaw-utgd/data/.openclaw/run/orin

# The existing runtime workspace owner on srv1532965.
ORIN_RUNTIME_UID=1000
ORIN_RUNTIME_GID=1000

# Loopback only. Do not add Traefik labels during maintenance.
ORIN_API_PORT=58080

# One isolated generic OAuth tenant handled by the approval-only worker.
# Fixed legacy clients use their existing dedicated workers.
ORIN_OAUTH_DRAFT_CLIENT_ID=orin_oauth_test

# Keep model generation disabled until a dedicated writer key and supervised
# dry-run have both passed.
ORIN_MODEL_WRITER_ENABLED=0
