# Public project URL; this is not a secret.
ORIN_SUPABASE_URL=https://hgbpfkrenxfezaztwlkp.supabase.co

# Mount a mode-0400 file containing the session-pooler or direct PostgreSQL URL
# for the dedicated orin_api login. Never use postgres or service_role.
ORIN_DATABASE_URL_FILE=/run/secrets/control_database_url

ORIN_DATABASE_ROLE=orin_api
ORIN_DB_POOL_SIZE=1
ORIN_JWT_AUDIENCE=authenticated
ORIN_JWT_ALGORITHM=ES256
