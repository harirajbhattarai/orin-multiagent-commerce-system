# Supply a session-pooler or direct PostgreSQL URL for the dedicated
# orin_worker login. Create and store it outside Git, chat, OpenClaw, and the
# container image. Never use postgres or service_role.
ORIN_WORKER_DATABASE_URL_FILE=/run/secrets/worker_database_url

ORIN_WORKER_DATABASE_ROLE=orin_worker
ORIN_WORKSPACE_ROOT=/runtime
